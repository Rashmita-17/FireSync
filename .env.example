PROJECT_NAME="NASA Space Apps: MODIS & VIIRS Harmonization Engine"
API_V1_STR=/api
DEBUG=False

# NASA FIRMS API Map Key (Required for live satellite hotspot ingestion)
# Obtain free instant key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
MAP_KEY=your_nasa_firms_map_key_here

# Allowed CORS Origins (comma-separated or wildcard)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Database configuration (SQLite by default, or PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./data/nasa_observations.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nasa_firms

# Spatio-Temporal Harmonization Hyperparameters
DEFAULT_SPATIAL_BANDWIDTH_KM=2.5
DEFAULT_TEMPORAL_BANDWIDTH_HOURS=6.0
DEFAULT_MIN_CLUSTER_SIZE=3
DEFAULT_MIN_SAMPLES=1
DEFAULT_CLUSTER_EPSILON=0.5

# Multi-Sensor Verification Bonus
CROSS_SENSOR_CONFIDENCE_BONUS=15.0
