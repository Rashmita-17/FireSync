# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional custom vector/raster basemap style URL (defaults to 100% free OpenFreeMap Dark with zero tokens)
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# Optional CARTO API key if using CARTO Dark Matter vector basemaps (carto.com/basemaps)
# NEXT_PUBLIC_CARTO_API_KEY=
